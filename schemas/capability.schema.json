{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:techecho:physica-core:schema:capability:0.1",
  "title": "PhysicaCapabilityMetadata",
  "description": "Optional product capability metadata. This declares compatibility only; it is not a service or business API contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_id",
    "contract_version",
    "core_version",
    "capabilities"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "contract_version": {
      "$ref": "#/$defs/semver"
    },
    "core_version": {
      "$ref": "#/$defs/semver"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 80
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
