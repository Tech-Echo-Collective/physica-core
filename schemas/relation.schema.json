{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:techecho:physica-core:schema:relation:0.1",
  "title": "ConceptRelation",
  "description": "One directed relation authored on a PhysicsConcept record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "target"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "requires",
        "generalizes",
        "derived-from",
        "used-in",
        "analogous-to"
      ]
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
