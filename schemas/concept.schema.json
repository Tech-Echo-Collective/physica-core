{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:techecho:physica-core:schema:concept:0.1",
  "title": "PhysicsConcept",
  "description": "A canonical, product-neutral physics or supporting mathematics concept.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "domains",
    "aliases",
    "relations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 80
      }
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "urn:techecho:physica-core:schema:relation:0.1"
      }
    }
  }
}
